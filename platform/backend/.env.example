# Database
# For development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./storage/dev.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rageval

# Storage
STORAGE_PATH=./storage

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# Debug mode
DEBUG=false

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM settings
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini

# Evaluation settings
EVAL_CHECKPOINT_INTERVAL=5
EVAL_MAX_CONCURRENT=1

# Webhook settings
WEBHOOK_MAX_PER_PROJECT=3
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=3
